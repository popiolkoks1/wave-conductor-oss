{
  "name": "wave-conductor",
  "version": "0.1.0",
  "description": "Plan-driven parallel coding workflows with Git worktrees, quality gates and resumable Claude Code sessions",
  "scripts": {
    "conduct": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "bash examples/toy/smoke.sh",
    "smoke:resilience": "bash examples/toy/smoke-resilience.sh"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "bin": {
    "conduct": "./bin/conduct"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/popiolkoks1/wave-conductor-oss.git"
  },
  "engines": {
    "node": ">=22"
  }
}
